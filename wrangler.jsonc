{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aligor",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/register", "/register/*", "/classregister", "/preview-live", "/survey", "/payment", "/invoice/*", "/4916", "/4916/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aligor-leads",
      "database_id": "0ecc5f24-f4c9-452b-9afd-bec7d0825255"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://aligor.aligor.workers.dev",
    "PREVIEW_ACCESS_BATCH": "PREVIEW-1028",
    "PROMO_ENDS_AT": "2026-10-22T00:00:00+08:00",
    "WHATSAPP_NUMBER": "60167871902",
    "META_PIXEL_ID": "1697028392130040",
    "SHOPIFY_DOMAIN": "ukunili2u.myshopify.com",
    "INVOICE_ISSUER_NAME": "NILI RESOURCES",
    "INVOICE_ISSUER_BRAND": "Aligor",
    "INVOICE_ISSUER_ADDRESS": "25, Jalan Pertama 4, Pusat Perdagangan Danga Utama, 81200 Johor Bahru, Johor",
    "INVOICE_ISSUER_PHONE": "60167871902",
    "ALLOWED_ORIGINS": "https://aligor.aligor.workers.dev"
  }
}
